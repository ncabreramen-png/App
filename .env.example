# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor. Necesaria para crear usuarios desde la pantalla del gerente.
# NUNCA exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publica de la app, usada en los links de los correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones por correo (Resend). Si se dejan vacias, la app funciona
# igual pero no envia correos.
RESEND_API_KEY=
CORREO_REMITENTE="Reportes Chilama <reportes@tu-dominio.com>"
